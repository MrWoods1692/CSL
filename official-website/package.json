    "input-otp": "^1.4.2",
    // ZIP 文件处理库
    "jszip": "^3.10.1",
    // 现代化的 HTTP 请求库
    "ky": "^1.13.0",
    // Lucide 图标库（React 组件）
    "lucide-react": "^0.576.0",
    // 动画库（原 Framer Motion 的继任者）
    "motion": "^12.23.25",
    // 主题切换工具（支持亮色/暗色模式）
    "next-themes": "^0.4.6",
    // 二维码生成库
    "qrcode": "^1.5.4",
    // React 核心库
    "react": "^18.0.0",
    // 日期选择器组件
    "react-day-picker": "^9.13.0",
    // React DOM 渲染
    "react-dom": "^18.0.0",
    // 文件拖拽上传组件
    "react-dropzone": "^14.3.8",
    // React Helmet 异步版本（SEO 头部管理）
    "react-helmet-async": "^2.0.5",
    // 表单状态管理和校验
    "react-hook-form": "^7.66.0",
    // 可调整大小的面板组件
    "react-resizable-panels": "^2.1.8",
    // React 路由核心
    "react-router": "^7.9.5",
    // React 路由 DOM 绑定
    "react-router-dom": "^7.9.5",
    // 图表库（基于 D3）
    "recharts": "2.15.4",
    // Toast 通知组件
    "sonner": "^2.0.7",
    // Markdown 流式渲染
    "streamdown": "^1.4.0",
    // Tailwind CSS 类名合并工具（解决类名冲突）
    "tailwind-merge": "^3.3.1",
    // Tailwind CSS 动画插件
    "tailwindcss-animate": "^1.0.7",
    // Tailwind CSS 交叉观察器插件（滚动触发动画）
    "tailwindcss-intersect": "^2.2.0",
    // 抽屉组件（移动端侧滑面板）
    "vaul": "^1.1.2",
    // 视频播放器组件
    "video-react": "^0.16.0",
    // 数据校验库（TypeScript 优先）
    "zod": "^3.25.76"
  },
  // 开发依赖
  "devDependencies": {
    // Biome 代码格式化和规范检查工具
    "@biomejs/biome": "2.4.5",
    // Tailwind CSS 容器查询插件
    "@tailwindcss/container-queries": "^0.1.1",
    // 百度地图 GL 类型定义
    "@types/bmapgl": "^0.0.7",
    // Lodash 类型定义
    "@types/lodash": "^4.17.24",
    // React 类型定义
    "@types/react": "^18.3.12",
    // React DOM 类型定义
    "@types/react-dom": "^18.3.1",
    // video-react 类型定义
    "@types/video-react": "^0.15.8",
    // Vite 的 React 插件（支持 JSX 转换和 Fast Refresh）
    "@vitejs/plugin-react": "^4.3.4",
    // CSS 自动添加浏览器前缀
    "autoprefixer": "^10.4.27",
    // CSS 后处理器
    "postcss": "^8.5.6",
    // Tailwind CSS 框架
    "tailwindcss": "^3.4.11",
    // TypeScript 编译器
    "typescript": "~5.6.3",
    // Vite 构建工具
    "vite": "^5.4.10",
    // Vite SVG 组件化插件（将 SVG 导入为 React 组件）
    "vite-plugin-svgr": "^4.3.0"
  }
}
