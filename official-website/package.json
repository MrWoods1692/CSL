  // 版本号：初始开发版本
  "version": "0.1.0",
  // 模块类型：使用 ES Module 规范
  "type": "module",
  // 脚本命令定义
  "scripts": {
    // 启动开发服务器（Vite 热更新）
    "dev": "vite",
    // 构建生产版本：先 TypeScript 类型检查，再 Vite 打包
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    // 预览生产构建结果
    "preview": "vite preview",
    // 代码检查：TypeScript 类型检查 + Biome 代码规范检查 + Tailwind CSS 语法检查
    "lint": "tsc -p tsconfig.app.json --noEmit && npx biome lint && npx tailwindcss -i ./src/index.css -o /dev/null 2>&1 | grep -E '^(CssSyntaxError|Error):.*' || true"
  },
  // 生产依赖
  "dependencies": {
    // React Hook Form 的 Zod 校验器适配器
    "@hookform/resolvers": "^5.2.2",
    // Radix UI 无障碍组件库 - 手风琴组件
    "@radix-ui/react-accordion": "^1.2.12",
    // Radix UI - 警告对话框
    "@radix-ui/react-alert-dialog": "^1.1.15",
    // Radix UI - 宽高比容器
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    // Radix UI - 头像组件
    "@radix-ui/react-avatar": "^1.1.10",
    // Radix UI - 复选框
    "@radix-ui/react-checkbox": "^1.3.3",
    // Radix UI - 可折叠面板
    "@radix-ui/react-collapsible": "^1.1.12",
    // Radix UI - 右键菜单
    "@radix-ui/react-context-menu": "^2.2.16",
    // Radix UI - 对话框/模态框
    "@radix-ui/react-dialog": "^1.1.15",
    // Radix UI - 下拉菜单
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    // Radix UI - 悬浮卡片
    "@radix-ui/react-hover-card": "^1.1.15",
    // Radix UI - 图标库
    "@radix-ui/react-icons": "^1.3.2",
    // Radix UI - 标签
    "@radix-ui/react-label": "^2.1.7",
    // Radix UI - 菜单栏
    "@radix-ui/react-menubar": "^1.1.16",
    // Radix UI - 导航菜单
    "@radix-ui/react-navigation-menu": "^1.2.14",
    // Radix UI - 弹出框
    "@radix-ui/react-popover": "^1.1.15",
    // Radix UI - 进度条
    "@radix-ui/react-progress": "^1.1.7",
    // Radix UI - 单选按钮组
    "@radix-ui/react-radio-group": "^1.3.8",
    // Radix UI - 自定义滚动区域
    "@radix-ui/react-scroll-area": "^1.2.10",
    // Radix UI - 选择下拉框
    "@radix-ui/react-select": "^2.2.6",
    // Radix UI - 分隔线
    "@radix-ui/react-separator": "^1.1.7",
    // Radix UI - 滑块
    "@radix-ui/react-slider": "^1.3.6",
    // Radix UI - 插槽（用于组件组合）
    "@radix-ui/react-slot": "^1.2.3",
    // Radix UI - 开关
    "@radix-ui/react-switch": "^1.2.6",
    // Radix UI - 标签页
    "@radix-ui/react-tabs": "^1.1.13",
    // Radix UI - Toast 通知
    "@radix-ui/react-toast": "^1.2.15",
    // Radix UI - 切换按钮
    "@radix-ui/react-toggle": "^1.1.10",
    // Radix UI - 切换按钮组
    "@radix-ui/react-toggle-group": "^1.1.11",
    // Radix UI - 工具提示
    "@radix-ui/react-tooltip": "^1.2.8",
    // Sentry 错误监控（React 集成）
    "@sentry/react": "^9.47.1",
    // Supabase 后端服务客户端
    "@supabase/supabase-js": "2.103.1",
    // HTTP 请求库
    "axios": "^1.13.1",
    // 类名变体管理工具（用于 shadcn/ui 组件变体）
    "class-variance-authority": "^0.7.1",
    // 类名拼接工具
    "clsx": "^2.1.1",
